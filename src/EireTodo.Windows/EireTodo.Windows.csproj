<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SUMAPP</AssemblyName>
    <Product>SUMAPP</Product>
    <Title>SUMAPP</Title>
    <Version>3.3.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/AppIcon.ico" /><Resource Include="Assets/AppIcon.png" /><Resource Include="Assets/SumappLogo.png" /><Resource Include="Assets/EireLogo.png" Condition="Exists('Assets/EireLogo.png')" /></ItemGroup>
  <ItemGroup><Resource Include="../EireTodo.Core/Assets/*.ttf" Link="Assets/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../EireTodo.Core/EireTodo.Core.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" /></ItemGroup>
</Project>
